# Copy to .env (gitignored) and fill in. One OpenAI-compatible endpoint;
# switching provider is a change to these three lines.

# Modal (our vLLM app; URL printed by `modal deploy src/seance/modal_app.py`):
# SEANCE_BASE_URL=https://<workspace>--seance-vllm-serve.modal.run/v1
# SEANCE_API_KEY=<the key you set in the Modal secret>
# SEANCE_MODEL=Qwen/Qwen3.8-27B-FP8   (must equal the deployed SEANCE_MODAL_MODEL)

# OpenRouter:
# SEANCE_BASE_URL=https://openrouter.ai/api/v1
# SEANCE_API_KEY=sk-or-...
# SEANCE_MODEL=qwen/qwen3-32b

# Nebius AI Studio:
# SEANCE_BASE_URL=https://api.studio.nebius.com/v1/
# SEANCE_API_KEY=...
# SEANCE_MODEL=Qwen/Qwen3-32B

SEANCE_BASE_URL=
SEANCE_API_KEY=
SEANCE_MODEL=

# Optional
SEANCE_TEMPERATURE=0.7
SEANCE_MAX_TOKENS=1024
# json_schema (strict structured output), json_object, or none
SEANCE_JSON_MODE=json_schema
# Qwen3-family thinking mode: false (default; sent to vLLM as
# chat_template_kwargs.enable_thinking=false), true, or unset (send nothing,
# for providers that reject the field). Left on, thinking multiplies output
# tokens 5-10x. Logged in every game record; any reasoning text that still
# comes back is counted in the record's tokens.attempts_with_reasoning.
# On OpenRouter use unset plus SEANCE_EXTRA_BODY={"reasoning": {"enabled": false}}.
SEANCE_ENABLE_THINKING=false
# Extra request fields, as JSON (merged with the thinking setting).
SEANCE_EXTRA_BODY={}
SEANCE_TIMEOUT_S=120
SEANCE_HTTP_RETRIES=4

# The LLM monitor (detector). Any SEANCE_MONITOR_* left unset falls back to
# the SEANCE_* value above. Pin the model for the main runs.
# SEANCE_MONITOR_BASE_URL=
# SEANCE_MONITOR_API_KEY=
# SEANCE_MONITOR_MODEL=
# Must be > 0: each game is read 3 times and the readings averaged (fixed after the pilot).
SEANCE_MONITOR_TEMPERATURE=0.7
SEANCE_MONITOR_MAX_TOKENS=2048
