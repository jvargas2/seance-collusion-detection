# Copy to .env (gitignored) and fill in. One OpenAI-compatible endpoint;
# switching provider is a change to these three lines.

# Modal (our vLLM app; URL printed by `modal deploy src/seance/modal_app.py`):
# SEANCE_BASE_URL=https://<workspace>--seance-vllm-serve.modal.run/v1
# SEANCE_API_KEY=<the key you set in the Modal secret>
# SEANCE_MODEL=Qwen/Qwen3-8B

# OpenRouter:
# SEANCE_BASE_URL=https://openrouter.ai/api/v1
# SEANCE_API_KEY=sk-or-...
# SEANCE_MODEL=qwen/qwen3-32b

# Nebius AI Studio:
# SEANCE_BASE_URL=https://api.studio.nebius.com/v1/
# SEANCE_API_KEY=...
# SEANCE_MODEL=Qwen/Qwen3-32B

SEANCE_BASE_URL=
SEANCE_API_KEY=
SEANCE_MODEL=

# Optional
SEANCE_TEMPERATURE=0.7
SEANCE_MAX_TOKENS=1024
# json_schema (strict structured output), json_object, or none
SEANCE_JSON_MODE=json_schema
# Extra request fields, as JSON. For Qwen3 on vLLM, turn thinking off:
# SEANCE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
SEANCE_EXTRA_BODY={}
SEANCE_TIMEOUT_S=120
SEANCE_HTTP_RETRIES=4
